# Tech Knife Enterprise Management System - Environment Template
# Copy this file to .env and fill in your actual credentials.

# API Gateway URL & Client Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_APP_NAME="Tech Knife"
VITE_COMPANY_NAME="Tech Knife Corporation"
VITE_SLOGAN="It's time for technology"
VITE_ENVIRONMENT=development

# Google Drive & OAuth Configuration
GOOGLE_DRIVE_AUTH_MODE=OAUTH2
GOOGLE_DRIVE_PARENT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/drive/oauth2callback
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# MongoDB Atlas Database
MONGODB_URI=

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Gemini API Key
GEMINI_API_KEY=
