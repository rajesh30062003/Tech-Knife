# Tech Knife Backend Environment Configuration

# Service Network Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://www.techknife.com

# MongoDB Atlas Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/techknife?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_techknife_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_techknife_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=techknife-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@techknife.com
SMTP_PASS=your_smtp_app_password
